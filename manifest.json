{
  "manifest_version": 3,
  "name": "Wide Mode",
  "version": "1.0",
  "description": "One click: the page uses the full screen width and all columns fit without horizontal scrolling. Current tab only.",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Wide Mode on/off",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
